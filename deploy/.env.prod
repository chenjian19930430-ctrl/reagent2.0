# =============================================================================
# ReAgent · Production Environment
# =============================================================================
# WARNING: Fill real values before deploying to production!
# Never commit this file with real secrets to version control.
# =============================================================================

# Application
REAGENT_DEBUG=false
REAGENT_LOG_LEVEL=INFO
REAGENT_API_PORT=8000

# AI Model Providers
REAGENT_AI_DEFAULT_PROVIDER=openai
REAGENT_OPENAI_API_KEY=sk-prod-your-key-here
REAGENT_OPENAI_DEFAULT_MODEL=gpt-4o
REAGENT_ANTHROPIC_API_KEY=sk-ant-prod-your-key-here
REAGENT_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Storage
# For production, consider PostgreSQL instead of SQLite:
# REAGENT_DATABASE_URL=postgresql+asyncpg://reagent:password@postgres:5432/reagent
REAGENT_DATABASE_URL=sqlite:///./data/reagent.db
REAGENT_REDIS_URL=redis://redis:6379

# Output
REAGENT_CONTENT_OUTPUT_DIR=/app/outputs

# Security — CHANGE THESE IN PRODUCTION
REAGENT_JWT_SECRET=<generate-a-secure-random-string-here>

# Redis host port (keep internal-only in prod)
REAGENT_REDIS_HOST_PORT=6379
