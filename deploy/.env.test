# =============================================================================
# ReAgent · Test / Staging Environment
# =============================================================================

# Application
REAGENT_DEBUG=true
REAGENT_LOG_LEVEL=INFO
REAGENT_API_PORT=8000

# AI Model Providers
REAGENT_AI_DEFAULT_PROVIDER=openai
REAGENT_OPENAI_API_KEY=sk-your-staging-key-here
REAGENT_OPENAI_DEFAULT_MODEL=gpt-4o-mini
REAGENT_ANTHROPIC_API_KEY=sk-ant-your-staging-key-here
REAGENT_ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-20250514

# Storage
REAGENT_DATABASE_URL=sqlite:///./data/reagent.test.db
REAGENT_REDIS_URL=redis://redis:6379

# Output
REAGENT_CONTENT_OUTPUT_DIR=/app/outputs

# Security
REAGENT_JWT_SECRET=change-me-for-staging
