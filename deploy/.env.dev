# =============================================================================
# ReAgent · Development Environment
# =============================================================================

# Application
REAGENT_DEBUG=true
REAGENT_LOG_LEVEL=DEBUG
REAGENT_API_PORT=8000

# AI Model Providers
REAGENT_AI_DEFAULT_PROVIDER=openai
REAGENT_OPENAI_API_KEY=sk-your-dev-key-here
REAGENT_OPENAI_DEFAULT_MODEL=gpt-4o
REAGENT_ANTHROPIC_API_KEY=sk-ant-your-dev-key-here
REAGENT_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
REAGENT_LOCAL_API_BASE=http://localhost:11434/v1
REAGENT_LOCAL_DEFAULT_MODEL=qwen2.5:14b

# Storage
REAGENT_DATABASE_URL=sqlite:///./data/reagent.dev.db
REAGENT_REDIS_URL=redis://redis:6379

# Output
REAGENT_CONTENT_OUTPUT_DIR=/app/outputs
FFMPEG_PATH=ffmpeg
