# ReAgent Configuration
# Copy to .env and fill in your values

# Application
REAGENT_DEBUG=true
REAGENT_LOG_LEVEL=DEBUG

# AI Model Providers
REAGENT_AI_DEFAULT_PROVIDER=openai

# OpenAI
REAGENT_OPENAI_API_KEY=sk-your-key-here
REAGENT_OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic
REAGENT_ANTHROPIC_API_KEY=sk-ant-your-key-here
REAGENT_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Local (Ollama)
REAGENT_LOCAL_API_BASE=http://localhost:11434/v1
REAGENT_LOCAL_DEFAULT_MODEL=qwen2.5:14b

# Storage
REAGENT_DATABASE_URL=sqlite:///./reagent.db

# Security
REAGENT_JWT_SECRET=change-me-to-a-secure-random-string
