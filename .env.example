# ReAgent Configuration

# --- Application ---
REAGENT_APP_NAME=ReAgent
REAGENT_DEBUG=false
REAGENT_LOG_LEVEL=INFO

# --- Storage ---
REAGENT_DATABASE_URL=sqlite:///./reagent.db
REAGENT_REDIS_URL=redis://localhost:6379

# --- AI Model Providers ---
REAGENT_AI_DEFAULT_PROVIDER=openai

# OpenAI
REAGENT_OPENAI_API_KEY=sk-your-openai-api-key
REAGENT_OPENAI_BASE_URL=https://api.openai.com/v1
REAGENT_OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic
REAGENT_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
REAGENT_ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Local / Ollama
REAGENT_LOCAL_API_BASE=http://localhost:11434/v1
REAGENT_LOCAL_API_KEY=ollama
REAGENT_LOCAL_DEFAULT_MODEL=qwen2.5:14b

# --- Content Generation ---
REAGENT_CONTENT_OUTPUT_DIR=./outputs
REAGENT_FFMPEG_PATH=ffmpeg

# --- Security ---
REAGENT_JWT_SECRET=change-me-to-a-secure-random-string
